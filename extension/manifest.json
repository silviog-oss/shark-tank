{
  "manifest_version": 3,
  "name": "Shark Tank — Zendesk helper",
  "version": "1.0.0",
  "description": "Grab the next Shark Tank ticket and auto-assign it to yourself in Zendesk.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Shark Tank" },
  "background": { "service_worker": "background.js" },
  "permissions": ["scripting", "tabs"],
  "host_permissions": ["https://*.zendesk.com/*"],
  "content_scripts": [
    {
      "matches": ["https://silviog-oss.github.io/*"],
      "js": ["site-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.zendesk.com/agent/*"],
      "js": ["config.js", "zendesk-button.js"],
      "run_at": "document_idle"
    }
  ]
}
